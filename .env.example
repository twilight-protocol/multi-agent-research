# 复制成 .env 再填值：copy .env.example .env（Linux 服务器用 cp）
# 必填两个：DASHSCOPE_API_KEY、TAVILY_API_KEY；其余不填就用下面的默认值
# 服务器上容器通过 docker-compose.yml 的 env_file 读取本文件

# ===== 必填 =====
# 阿里云 DashScope API Key（百炼控制台 → API-KEY 管理）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 联网搜索密钥（Tavily 控制台）。研究图的搜索节点用；不填时启动不报错，
# 但跑到搜索节点会 RuntimeError（backend/ai/research/tools.py 里才校验）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# ===== 可选（不填就用默认值）=====
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 向量库目录。默认 data/chroma_db（相对项目根，与启动目录无关）
# CHROMA_DIR=

# 单次上传 PDF 大小上限（MB）：pypdf 解析超大文件会吃满内存
MAX_UPLOAD_MB=20

# 限流：同一 IP 在 WINDOW 秒内最多 MAX 次请求（保护 DashScope 额度）
# 研究请求与上传是两个独立计数桶，互不挤占
RESEARCH_RATE_LIMIT_MAX=5
RESEARCH_RATE_LIMIT_WINDOW=60
UPLOAD_RATE_LIMIT_MAX=3
UPLOAD_RATE_LIMIT_WINDOW=60
